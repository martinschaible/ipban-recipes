    <LogFile>
        <Id>03</Id>
        <Source>SSH - Bad Usernames Internal</Source>
        <PathAndMask>
            /var/log/auth*.log
            /var/log/secure*
            /var/log/messages
        </PathAndMask>
        <FailedLoginRegex><![CDATA[(?<log>(?:invalid|illegal)\s+user)\s+(?$$file:https://raw.githubusercontent.com/martinschaible/ipban-recipes/refs/heads/main/lists/ssh-bad-usernames-internal.txt$$)\s+from\s+(?<ipaddress>[^\s]+)]]></FailedLoginRegex>
        <FailedLoginRegexTimestampFormat />
        <FailedLoginLogLevel>Warning</FailedLoginLogLevel>
        <MinimumTimeBetweenFailedLoginAttempts />
        <SuccessfulLoginRegex>
        </SuccessfulLoginRegex>
        <SuccessfulLoginRegexTimestampFormat />
        <SuccessfulLoginLogLevel>Warning</SuccessfulLoginLogLevel>
        <PlatformRegex><![CDATA[Linux]]></PlatformRegex>
        <PingInterval>5000</PingInterval>
        <MaxFileSize>16777216</MaxFileSize>
        <FailedLoginThreshold>1</FailedLoginThreshold>
        <NotificationFlags>None</NotificationFlags>
        <Description>User names related to us or customers used for a login attempt</Description>
    </LogFile>